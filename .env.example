# =============================================================================
# Application
# =============================================================================
APP_NAME=VideoIntelligence
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string-in-production

# =============================================================================
# Backend
# =============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# =============================================================================
# Database (SQLite default for standalone evaluation, or PostgreSQL)
# =============================================================================
# For standalone local run without Docker (default):
DATABASE_URL=sqlite+aiosqlite:///./videointel.db
# For Docker Compose / PostgreSQL deployment:
# DATABASE_URL=postgresql+asyncpg://videointel:videointel_dev_password@localhost:5432/videointel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=videointel
POSTGRES_PASSWORD=videointel_dev_password
POSTGRES_DB=videointel

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# =============================================================================
# MinIO (S3-compatible Object Storage)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=videointel
MINIO_USE_SSL=false

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# AI Services (DO NOT commit real keys — use .env only)
# =============================================================================
OPENAI_API_KEY=
ASSEMBLYAI_API_KEY=
GOOGLE_AI_API_KEY=

# =============================================================================
# File Upload Limits
# =============================================================================
MAX_VIDEO_SIZE_MB=2048
MAX_DOCUMENT_SIZE_MB=50
ALLOWED_VIDEO_EXTENSIONS=.mp4,.webm,.mkv,.avi,.mov
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.m4a,.ogg,.flac
ALLOWED_DOCUMENT_EXTENSIONS=.pptx,.ppt,.pdf

# =============================================================================
# Processing
# =============================================================================
MEDIA_RETENTION_DAYS=7
